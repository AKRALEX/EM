<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0d1b2a">
<title>Grilles Euromillions</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icons/icone-192.png">
<link rel="apple-touch-icon" href="icons/icone-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  /* Une colonne pensee pour le pouce : commande en haut, grilles en dessous,
     reglages replies en bas. Palette reprise du dashboard PC (marine + or). */
  color-scheme: dark;
  --fond: #0d1b2a;
  --panneau: #16263b;
  --trait: #2a3d57;
  --texte: #e8edf5;
  --discret: #9aa9bd;
  --boule: #2148b8;
  --or: #f4c542;
  --ok: #4ade80;
  --alerte: #fb923c;
  --erreur: #f87171;
  --titre: "Sora", "Segoe UI", system-ui, sans-serif;
  --corps: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { margin: 0; }
body {
  background: var(--fond);
  color: var(--texte);
  font-family: var(--corps);
  font-size: 16px;
  line-height: 1.45;
  -webkit-text-size-adjust: 100%;
}
main {
  max-width: 560px;
  margin: 0 auto;
  padding: 20px 16px 48px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
h1 {
  font-family: var(--titre);
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0;
  text-wrap: balance;
}
h2 {
  font-family: var(--titre);
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
}
p { margin: 0; }
.discret { color: var(--discret); font-size: 0.875rem; }
button, input, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 2px solid var(--or); outline-offset: 2px; }

/* --- Dernier tirage connu --- */
.tirage {
  background: var(--panneau);
  border: 1px solid var(--trait);
  border-radius: 14px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.tirage-tete {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.pastille {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 3px 9px;
  border-radius: 999px;
  border: 1px solid currentColor;
  white-space: nowrap;
}
.pastille.ok { color: var(--ok); }
.pastille.alerte { color: var(--alerte); }
.pastille.neutre { color: var(--discret); }

/* --- Boules et etoiles --- */
.numeros { display: flex; align-items: center; gap: 6px; }
.boule, .etoile {
  flex: 0 1 42px; min-width: 0; aspect-ratio: 1;
  display: grid; place-items: center;
  font-family: var(--titre);
  font-weight: 600;
  font-size: 1rem;
  font-variant-numeric: tabular-nums;
  flex: none;
}
.boule { background: var(--boule); color: #fff; border-radius: 50%; }
.etoile {
  background: var(--or);
  color: var(--fond);
  clip-path: polygon(50% 2%, 63% 35%, 98% 37%, 71% 59%, 80% 94%, 50% 74%, 20% 94%, 29% 59%, 2% 37%, 37% 35%);
  font-size: 0.875rem;
  padding-top: 3px;
}
.petit .boule, .petit .etoile { flex-basis: 32px; font-size: 0.8125rem; }
.petit .etoile { font-size: 0.6875rem; }
.sep { flex: none; width: 1px; height: 26px; background: var(--trait); margin: 0 2px; }

/* --- Commande --- */
.commande {
  display: flex;
  gap: 10px;
  align-items: stretch;
}
.pas {
  display: flex;
  align-items: stretch;
  background: var(--panneau);
  border: 1px solid var(--trait);
  border-radius: 12px;
  overflow: hidden;
}
.pas button {
  width: 46px;
  background: none;
  border: 0;
  font-size: 1.375rem;
  font-weight: 600;
}
.pas button:active { background: var(--trait); }
.pas input {
  width: 52px;
  text-align: center;
  background: none;
  border: 0;
  border-inline: 1px solid var(--trait);
  font-family: var(--titre);
  font-weight: 600;
  font-size: 1.125rem;
  -moz-appearance: textfield;
}
.pas input::-webkit-outer-spin-button, .pas input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.principal {
  flex: 1;
  min-height: 52px;
  background: var(--or);
  color: var(--fond);
  border: 0;
  border-radius: 12px;
  font-family: var(--titre);
  font-weight: 700;
  font-size: 1.0625rem;
}
.principal:disabled { opacity: 0.55; cursor: progress; }
.secondaire {
  background: none;
  border: 1px solid var(--trait);
  border-radius: 10px;
  padding: 9px 14px;
  font-weight: 500;
  font-size: 0.9375rem;
}
.secondaire:active { background: var(--panneau); }
.secondaire.danger { color: var(--erreur); }

/* --- Grilles --- */
.bloc { display: flex; flex-direction: column; gap: 10px; }
.bloc-tete { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.carte {
  background: var(--panneau);
  border: 1px solid var(--trait);
  border-radius: 14px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.carte-tete { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.carte-tete strong { font-family: var(--titre); font-weight: 600; }
.puce {
  font-size: 0.6875rem;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 6px;
  background: rgba(251, 146, 60, 0.14);
  color: var(--alerte);
}
.message { font-size: 0.875rem; color: var(--discret); }
.message.erreur { color: var(--erreur); }

/* --- Sections repliables --- */
details {
  border: 1px solid var(--trait);
  border-radius: 12px;
  background: var(--panneau);
}
summary {
  padding: 13px 14px;
  font-weight: 600;
  cursor: pointer;
  list-style-position: inside;
}
.contenu { padding: 0 14px 14px; display: flex; flex-direction: column; gap: 12px; }
.saisie { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.saisie input[type="number"] {
  width: 46px; height: 42px;
  text-align: center;
  background: var(--fond);
  border: 1px solid var(--trait);
  border-radius: 8px;
  -moz-appearance: textfield;
}
.saisie input.e { border-color: var(--or); }
.saisie input::-webkit-outer-spin-button, .saisie input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
input[type="date"], textarea {
  background: var(--fond);
  border: 1px solid var(--trait);
  border-radius: 8px;
  padding: 9px 10px;
}
textarea { width: 100%; min-height: 84px; font-size: 0.8125rem; font-family: ui-monospace, Consolas, monospace; }
.rangee { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.session { display: flex; flex-direction: column; gap: 6px; padding-top: 10px; border-top: 1px solid var(--trait); }
.session:first-child { border-top: 0; padding-top: 0; }
.table { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
th, td { text-align: left; padding: 6px 8px 6px 0; border-bottom: 1px solid var(--trait); white-space: nowrap; }
th { color: var(--discret); font-weight: 500; }
td.ecartee { color: var(--discret); }
footer { color: var(--discret); font-size: 0.8125rem; }
@media (prefers-reduced-motion: no-preference) {
  .carte.neuve { animation: arrivee 0.25s ease-out both; }
  @keyframes arrivee { from { transform: translateY(6px); opacity: 0.4; } to { transform: none; opacity: 1; } }
}
</style>
</head>
<body>
<main>
  <header>
    <h1>Grilles Euromillions</h1>
  </header>

  <section class="tirage" aria-live="polite">
    <div class="tirage-tete">
      <span class="discret" id="tirage-date">Dernier tirage connu : chargement…</span>
      <span class="pastille neutre" id="tirage-etat">Chargement</span>
    </div>
    <div class="numeros" id="tirage-numeros"></div>
    <p class="discret" id="tirage-detail"></p>
  </section>

  <section class="commande">
    <div class="pas">
      <button type="button" id="moins" aria-label="Une grille de moins">−</button>
      <input type="number" id="nb" min="1" max="50" value="5" inputmode="numeric" aria-label="Nombre de grilles">
      <button type="button" id="plus" aria-label="Une grille de plus">+</button>
    </div>
    <button type="button" class="principal" id="generer" disabled>Préparation du moteur…</button>
  </section>
  <p class="message" id="etat" aria-live="polite"></p>

  <section class="bloc">
    <div class="bloc-tete">
      <h2 id="grilles-titre">Dernière session</h2>
      <button type="button" class="secondaire" id="copier">Copier les grilles</button>
    </div>
    <p class="message" id="resume"></p>
    <div class="bloc" id="grilles"></div>
  </section>

  <details id="d-tirage">
    <summary>Ajouter un tirage à la main</summary>
    <div class="contenu">
      <p class="discret">À utiliser seulement si le dernier tirage n'est pas encore arrivé tout seul. Un tirage déjà présent dans le fichier FDJ est ignoré.</p>
      <label class="rangee"><span class="discret">Date</span> <input type="date" id="m-date"></label>
      <div class="saisie" id="m-boules">
        <input type="number" id="m-b1" min="1" max="50" inputmode="numeric" aria-label="Boule 1">
        <input type="number" id="m-b2" min="1" max="50" inputmode="numeric" aria-label="Boule 2">
        <input type="number" id="m-b3" min="1" max="50" inputmode="numeric" aria-label="Boule 3">
        <input type="number" id="m-b4" min="1" max="50" inputmode="numeric" aria-label="Boule 4">
        <input type="number" id="m-b5" min="1" max="50" inputmode="numeric" aria-label="Boule 5">
        <span class="sep"></span>
        <input type="number" class="e" id="m-e1" min="1" max="12" inputmode="numeric" aria-label="Étoile 1">
        <input type="number" class="e" id="m-e2" min="1" max="12" inputmode="numeric" aria-label="Étoile 2">
      </div>
      <div class="rangee">
        <button type="button" class="secondaire" id="m-ajouter">Ajouter ce tirage</button>
        <button type="button" class="secondaire danger" id="m-vider" hidden>Retirer les tirages saisis</button>
      </div>
      <p class="message" id="m-etat"></p>
    </div>
  </details>

  <details id="d-sessions">
    <summary>Sessions précédentes</summary>
    <div class="contenu">
      <p class="discret">Les 4 dernières sessions réduisent le quota des numéros déjà proposés. Cet historique vit dans ce navigateur : copiez-le pour le sauvegarder ou le reporter sur un autre appareil.</p>
      <div class="bloc" id="sessions"></div>
      <div class="rangee">
        <button type="button" class="secondaire" id="h-copier">Copier l'historique</button>
        <button type="button" class="secondaire" id="h-montrer-import">Importer…</button>
        <button type="button" class="secondaire danger" id="h-effacer">Effacer</button>
      </div>
      <div class="bloc" id="h-import" hidden>
        <textarea id="h-texte" placeholder="Collez ici le contenu de historique_grilles.json"></textarea>
        <div class="rangee"><button type="button" class="secondaire" id="h-importer">Remplacer l'historique</button></div>
      </div>
      <p class="message" id="h-etat"></p>
    </div>
  </details>

  <details id="d-methodes">
    <summary>Méthodes et réglages</summary>
    <div class="contenu">
      <p class="discret" id="methodes-intro"></p>
      <div class="table"><table id="methodes"></table></div>
    </div>
  </details>

  <footer>
    <p>Aucune méthode ne bat le hasard : ces réglages servent la diversité et la plausibilité des grilles, pas les chances de gain. Jouer comporte des risques.</p>
  </footer>
</main>

<script src="https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js"></script>
<script>
"use strict";
const PYODIDE_URL = "https://cdn.jsdelivr.net/pyodide/v0.26.4/full/";
const CSV_URL = "data/euromillions_202002.csv";
const CLE_SESSIONS = "em_sessions_v1";
const CLE_MANUELS = "em_tirages_manuels_v1";
const CLE_NB = "em_nb_grilles";

const $ = (id) => document.getElementById(id);
const etat = { py: null, tiragesCsv: [], tirages: [], methodes: [], sessions: [], manuels: [], derniere: null };

/* ---------- Stockage local (peut manquer : toujours en try/catch) ---------- */
function lire(cle, defaut) {
  try { const v = localStorage.getItem(cle); return v === null ? defaut : JSON.parse(v); }
  catch (e) { return defaut; }
}
function ecrire(cle, valeur) {
  try { localStorage.setItem(cle, JSON.stringify(valeur)); return true; }
  catch (e) { return false; }
}

/* ---------- Petits utilitaires ---------- */
function el(balise, classe, texte) {
  const n = document.createElement(balise);
  if (classe) n.className = classe;
  if (texte !== undefined) n.textContent = texte;
  return n;
}
function numeros(boules, etoiles, petit) {
  const d = el("div", "numeros" + (petit ? " petit" : ""));
  for (const b of boules) d.append(el("span", "boule", String(b)));
  if (etoiles && etoiles.length) {
    d.append(el("span", "sep"));
    for (const e of etoiles) d.append(el("span", "etoile", String(e)));
  }
  return d;
}
const fmtJour = new Intl.DateTimeFormat("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const fmtCourt = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
function dateLocale(iso) { const [a, m, j] = iso.split("-").map(Number); return new Date(a, m - 1, j); }
function isoJour(d) {
  return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
}

/* Tirages (mardi et vendredi, vers 21 h) deja joues depuis la date connue.
   Un tirage du jour ne compte qu'a partir de 22 h, le temps que FDJ publie. */
function tiragesManquants(isoConnu, maintenant) {
  let n = 0;
  const d = dateLocale(isoConnu);
  d.setDate(d.getDate() + 1);
  while (d <= maintenant) {
    const jour = d.getDay();
    if (jour === 2 || jour === 5) {
      const publie = new Date(d.getFullYear(), d.getMonth(), d.getDate(), 22, 0);
      if (maintenant >= publie) n++;
    }
    d.setDate(d.getDate() + 1);
  }
  return n;
}

/* ---------- Affichage ---------- */
function afficherTirage() {
  const t = etat.tirages[0];
  if (!t) return;
  const manuel = etat.manuels.some((m) => m.date === t.date);
  $("tirage-date").textContent = "Dernier tirage connu : " + fmtJour.format(dateLocale(t.date));
  $("tirage-numeros").replaceChildren(...numeros(t.boules.slice().sort((a, b) => a - b), t.etoiles.slice().sort((a, b) => a - b)).childNodes);
  const manque = tiragesManquants(t.date, new Date());
  const p = $("tirage-etat");
  if (manque === 0) { p.className = "pastille ok"; p.textContent = "À jour"; }
  else { p.className = "pastille alerte"; p.textContent = manque === 1 ? "1 tirage manquant" : manque + " tirages manquants"; }
  $("tirage-detail").textContent =
    etat.tirages.length + " tirages chargés, les 50 plus récents servent au calcul" +
    (manuel ? " · dernier tirage saisi à la main" : "") + ".";
}

function afficherGrilles(cartes, neuves) {
  const zone = $("grilles");
  zone.replaceChildren();
  for (const c of cartes) {
    const carte = el("article", "carte" + (neuves ? " neuve" : ""));
    const tete = el("div", "carte-tete");
    tete.append(el("strong", null, "Grille " + c.num));
    if (c.methode) tete.append(el("span", "discret", c.methode));
    if (c.badge) {
      if (c.badge.repli === "aleatoire") tete.append(el("span", "puce", "aléatoire pur"));
      if (c.badge.repli === "anti-doublon") tete.append(el("span", "puce", "anti-doublon"));
      if (c.badge.quota_relache === 1) tete.append(el("span", "puce", "quota élargi"));
      if (c.badge.quota_relache === 2) tete.append(el("span", "puce", "quota levé"));
    }
    carte.append(tete, numeros(c.grille, c.etoiles));
    if (c.somme !== undefined) carte.append(el("p", "discret", "somme " + c.somme + " · étendue " + c.etendue));
    zone.append(carte);
  }
  $("copier").hidden = cartes.length === 0;
}

function cartesDepuisSession(s) {
  return s.grilles.map((g, i) => ({ num: i + 1, grille: g, etoiles: s.etoiles ? s.etoiles[i] : null }));
}

function afficherDerniereSession() {
  const s = etat.sessions[etat.sessions.length - 1];
  if (!s) {
    $("grilles-titre").textContent = "Aucune grille pour l'instant";
    $("resume").textContent = "Choisissez un nombre de grilles puis touchez Générer.";
    afficherGrilles([], false);
    return;
  }
  $("grilles-titre").textContent = "Dernière session";
  $("resume").textContent = "Générée le " + fmtCourt.format(new Date(s.date)) + (s.etoiles ? "." : ", sur le PC (étoiles non enregistrées).");
  afficherGrilles(cartesDepuisSession(s), false);
}

function afficherSessions() {
  const zone = $("sessions");
  zone.replaceChildren();
  const liste = etat.sessions.slice().reverse();
  if (!liste.length) zone.append(el("p", "discret", "Aucune session enregistrée."));
  liste.forEach((s, i) => {
    const bloc = el("div", "session");
    const poids = i < 4 ? " · compte dans le quota" : "";
    bloc.append(el("p", "discret", fmtCourt.format(new Date(s.date)) + " · " + s.grilles.length + " grilles" + poids));
    bloc.append(el("p", null, s.grilles.map((g) => g.join(" ")).join("  ·  ")));
    bloc.lastChild.style.fontSize = "0.8125rem";
    bloc.lastChild.style.fontVariantNumeric = "tabular-nums";
    zone.append(bloc);
  });
}

function afficherMethodes(ecartees) {
  const t = $("methodes");
  t.replaceChildren();
  const tr = el("tr");
  ["#", "Méthode", "Numéros méthode", "Amplitude", "Top", "Plausibles"].forEach((h) => tr.append(el("th", null, h)));
  t.append(tr);
  const jumelles = new Map(ecartees || []);
  for (const m of etat.methodes) {
    const l = el("tr");
    const ec = jumelles.has(m.nom);
    const cells = [m.rang, m.nom + (ec ? " (≈ " + jumelles.get(m.nom) + ")" : ""), m.nb_methode + " + " + m.nb_aleatoires + " aléatoires",
      "±" + m.amplitude, m.top_n, m.taux_plausible !== undefined ? Math.round(m.taux_plausible * 100) + " %" : "–"];
    cells.forEach((v) => l.append(el("td", ec ? "ecartee" : null, String(v))));
    t.append(l);
  }
  $("methodes-intro").textContent = etat.methodes.length + " méthodes issues du dernier backtest (best_params.json). " +
    (ecartees ? ecartees.length + " écartées à la dernière génération car leur classement recoupe celui d'une méthode mieux placée." :
      "Les méthodes redondantes sont écartées à chaque génération.");
}

/* ---------- Donnees ---------- */
function fusionnerTirages() {
  const connues = new Set(etat.tiragesCsv.map((t) => t.date));
  const ajout = etat.manuels.filter((m) => !connues.has(m.date));
  etat.tirages = ajout.concat(etat.tiragesCsv).sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
}

async function texte(url, options) {
  const r = await fetch(url, options);
  if (!r.ok) throw new Error(url + " : réponse " + r.status);
  return r.text();
}

async function demarrer() {
  etat.manuels = lire(CLE_MANUELS, []);
  $("nb").value = lire(CLE_NB, 5);

  // 1) Parametres et historique : affichage immediat, sans attendre Python.
  try {
    etat.methodes = JSON.parse(await texte("data/best_params.json", { cache: "no-cache" }));
  } catch (e) {
    $("etat").className = "message erreur";
    $("etat").textContent = "Impossible de lire data/best_params.json. " + e.message;
    return;
  }
  let sessions = lire(CLE_SESSIONS, null);
  if (!Array.isArray(sessions)) {
    try { sessions = JSON.parse(await texte("data/historique_initial.json")); } catch (e) { sessions = []; }
  }
  etat.sessions = sessions;
  afficherDerniereSession();
  afficherSessions();
  afficherMethodes(null);

  // 2) Moteur Python (les scripts du PC, inchanges).
  try {
    const py = await loadPyodide({ indexURL: PYODIDE_URL });
    py.FS.mkdirTree("/em");
    const fichiers = new Set(["em_moteur.py", "em_plausibilite.py"]);
    for (const m of etat.methodes) fichiers.add(m.script.replace(/\\/g, "/").split("/").pop().replace(/ /g, ""));
    // Certains hebergeurs ne servent pas les .py : on essaie alors la copie .txt.
    const script = (f) => texte("py/" + f).catch(() => texte("py/" + f + ".txt"));
    await Promise.all([...fichiers].map(async (f) => py.FS.writeFile("/em/" + f, await script(f))));
    py.runPython(`
import sys, json
sys.path.insert(0, "/em")
import em_moteur
def api_tirages(txt):
    return json.dumps(em_moteur.lire_tirages(txt))
def api_generer(p):
    d = json.loads(p)
