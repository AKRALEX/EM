/* ---------- Generation ---------- */
function generer() {
  let nb = parseInt($("nb").value, 10);
  if (!(nb >= 1)) nb = 1;
  if (nb > 50) nb = 50;
  $("nb").value = nb;
  ecrire(CLE_NB, nb);
  $("etat").className = "message";
  let r;
  try {
    r = JSON.parse(etat.py.globals.get("api_generer")(JSON.stringify({
      tirages: etat.tirages.slice(0, 50).map((t) => t.boules),
      methodes: etat.methodes, nb: nb, sessions: etat.sessions,
    })));
  } catch (e) {
    $("etat").className = "message erreur";
    $("etat").textContent = "La génération a échoué. " + e.message;
    return;
  }
  if (!r.grilles.length) {
    $("etat").className = "message erreur";
    $("etat").textContent = "Aucune méthode exploitable. " + r.erreurs.map((x) => x.methode + " : " + x.erreur).join(" ; ");
    return;
  }
  // Python (Pyodide) date en UTC : on remet l'heure du telephone.
  const d = new Date();
  r.sessions[r.sessions.length - 1].date = isoJour(d) + "T" + d.toTimeString().slice(0, 8);
  etat.sessions = r.sessions;
  etat.derniere = r;
  const sauve = ecrire(CLE_SESSIONS, etat.sessions);
  $("grilles-titre").textContent = r.grilles.length === 1 ? "1 grille" : r.grilles.length + " grilles";
  let resume = r.nb_actives + " méthodes retenues sur " + r.nb_methodes + " · quota de " + r.quota + " apparitions par numéro";
  if (r.penalises.length) resume += " · pénalisés par les sessions précédentes : " + r.penalises.join(", ");
  $("resume").textContent = resume + ".";
  afficherGrilles(r.grilles, true);
  afficherSessions();
  afficherMethodes(r.doublons);
  const soucis = [];
  if (r.erreurs.length) soucis.push("Méthodes en erreur : " + r.erreurs.map((x) => x.methode).join(", ") + ".");
  if (!sauve) soucis.push("Cette session n'a pas pu être enregistrée dans le navigateur : elle ne comptera pas dans le prochain quota.");
  $("etat").className = soucis.length ? "message erreur" : "message";
  $("etat").textContent = soucis.join(" ");
}

/* ---------- Copie ---------- */
async function copier(texteACopier, bouton, libelle) {
  try {
    await navigator.clipboard.writeText(texteACopier);
    bouton.textContent = "Copié";
  } catch (e) {
    bouton.textContent = "Copie refusée";
  }
  setTimeout(() => { bouton.textContent = libelle; }, 1600);
}
function texteGrilles() {
  const s = etat.sessions[etat.sessions.length - 1];
  if (!s) return "";
  return s.grilles.map((g, i) => g.join(" ") + (s.etoiles ? "  ★ " + s.etoiles[i].join(" ") : "")).join("\n");
}

/* ---------- Saisie manuelle d'un tirage ---------- */
function ajouterTirage() {
  const msg = $("m-etat");
  msg.className = "message erreur";
  const date = $("m-date").value;
  const boules = [1, 2, 3, 4, 5].map((i) => parseInt($("m-b" + i).value, 10));
  const etoiles = [1, 2].map((i) => parseInt($("m-e" + i).value, 10));
  if (!date) { msg.textContent = "Indiquez la date du tirage."; return; }
  if (dateLocale(date) > new Date()) { msg.textContent = "Cette date est dans le futur."; return; }
  const jour = dateLocale(date).getDay();
  if (jour !== 2 && jour !== 5) { msg.textContent = "Les tirages ont lieu le mardi et le vendredi : vérifiez la date."; return; }
  if (boules.some((b) => !(b >= 1 && b <= 50)) || new Set(boules).size !== 5) { msg.textContent = "Il faut 5 boules différentes entre 1 et 50."; return; }
  if (etoiles.some((e) => !(e >= 1 && e <= 12)) || new Set(etoiles).size !== 2) { msg.textContent = "Il faut 2 étoiles différentes entre 1 et 12."; return; }
  if (etat.tiragesCsv.some((t) => t.date === date)) { msg.textContent = "Ce tirage est déjà dans le fichier FDJ : rien à ajouter."; return; }
  etat.manuels = etat.manuels.filter((m) => m.date !== date).concat([{ date, boules, etoiles }]);
  const sauve = ecrire(CLE_MANUELS, etat.manuels);
  fusionnerTirages();
  afficherTirage();
  $("m-vider").hidden = false;
  msg.className = "message";
  msg.textContent = "Tirage du " + fmtJour.format(dateLocale(date)) + " ajouté." + (sauve ? "" : " Il sera perdu à la fermeture : le navigateur refuse l'enregistrement.");
  ["m-b1", "m-b2", "m-b3", "m-b4", "m-b5", "m-e1", "m-e2"].forEach((id) => { $(id).value = ""; });
}

/* ---------- Branchements ---------- */
$("moins").addEventListener("click", () => { $("nb").value = Math.max(1, (parseInt($("nb").value, 10) || 1) - 1); });
$("plus").addEventListener("click", () => { $("nb").value = Math.min(50, (parseInt($("nb").value, 10) || 0) + 1); });
$("generer").addEventListener("click", generer);
$("copier").addEventListener("click", () => copier(texteGrilles(), $("copier"), "Copier les grilles"));
$("m-ajouter").addEventListener("click", ajouterTirage);
$("m-vider").addEventListener("click", () => {
  etat.manuels = [];
  ecrire(CLE_MANUELS, []);
  fusionnerTirages();
  afficherTirage();
  $("m-vider").hidden = true;
  $("m-etat").className = "message";
  $("m-etat").textContent = "Tirages saisis à la main retirés.";
});
$("h-copier").addEventListener("click", () => copier(JSON.stringify(etat.sessions, null, 1), $("h-copier"), "Copier l'historique"));
$("h-montrer-import").addEventListener("click", () => { $("h-import").hidden = !$("h-import").hidden; });
$("h-importer").addEventListener("click", () => {
  const msg = $("h-etat");
  try {
    const s = JSON.parse($("h-texte").value);
    const valide = Array.isArray(s) && s.every((x) => x && typeof x.date === "string" && Array.isArray(x.grilles) &&
      x.grilles.every((g) => Array.isArray(g) && g.length === 5 && g.every((n) => Number.isInteger(n) && n >= 1 && n <= 50)));
    if (!valide) throw new Error("format inattendu");
    etat.sessions = s.slice(-12);
    ecrire(CLE_SESSIONS, etat.sessions);
    afficherDerniereSession();
    afficherSessions();
    $("h-import").hidden = true;
    $("h-texte").value = "";
    msg.className = "message";
    msg.textContent = etat.sessions.length + " sessions importées.";
  } catch (e) {
    msg.className = "message erreur";
    msg.textContent = "Ce texte n'est pas un historique valide (" + e.message + "). Collez le contenu complet de historique_grilles.json.";
  }
});
let effacerArme = false;
$("h-effacer").addEventListener("click", () => {
  const b = $("h-effacer");
  if (!effacerArme) {
    effacerArme = true;
    b.textContent = "Confirmer l'effacement";
    setTimeout(() => { effacerArme = false; b.textContent = "Effacer"; }, 4000);
    return;
  }
  effacerArme = false;
  b.textContent = "Effacer";
  etat.sessions = [];
  ecrire(CLE_SESSIONS, []);
  afficherDerniereSession();
  afficherSessions();
  $("h-etat").className = "message";
  $("h-etat").textContent = "Historique effacé : le prochain quota repart de zéro.";
});

demarrer();

